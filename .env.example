# Meridian Residences - shared environment contract
# (Project Design Document, section 15). Never commit a real .env file.
#
# NOTE (Member 1 / lease story): this file did not exist yet on `main`, so
# it is proposed here mirroring the frozen contract verbatim - nothing
# invented. One deviation: MONGODB_URL/MONGODB_DATABASE from the contract
# are omitted, since they were conditional on a "starter" project's Mongo
# doc-store that does not exist in this repo (flagged in the plan) - add
# them back only if the team decides to introduce Mongo for real.

# Backend
APP_NAME=meridian-residences
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1
DATABASE_URL=postgresql://user:password@localhost:5432/meridian_residences
CORS_ORIGINS=http://localhost:5173

# Authentication / security
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# AI / RAG (Member 4's story)
LLM_PROVIDER=<approved-provider>
LLM_MODEL=<approved-model>
LLM_API_KEY=<do-not-commit>
EMBEDDING_MODEL=<approved-embedding-model>
VECTOR_DB_URL=<if external vector DB is used>

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Automation / integrations
UIPATH_API_URL=<if required>
JIRA_BASE_URL=<if required>
JIRA_PROJECT_KEY=<if required>

# Observability
LOG_LEVEL=INFO
