# Real backend URL (used once the team's FastAPI service is running).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# DEMO-ONLY: set to "false" (or delete this line) once the real
# /api/v1/assistant/chat endpoint exists. While true, assistantService
# answers from a small local mock instead of calling the network.
VITE_MOCK_ASSISTANT=true
